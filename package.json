{
  "name": "lesson-planner",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "serve": "vite build --config app/vite.config.ts && vite preview --config app/vite.config.ts --port 4173 --strictPort",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:e2e": "playwright test",
    "test:ui": "playwright test --ui",
    "test:update": "playwright test --update-snapshots",
    "test:trace": "playwright show-trace",
    "lint": "eslint . --max-warnings 0",
    "build:app": "vite build --config app/vite.config.ts",
    "dev:app": "vite --config app/vite.config.ts",
    "preview:app": "vite preview --config app/vite.config.ts",
    "typecheck:app": "tsc --noEmit -p app/tsconfig.json"
  },
  "devDependencies": {
    "@faker-js/faker": "10.6.0",
    "@playwright/test": "1.63.0",
    "@types/node": "26.4.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "10.10.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-playwright": "2.11.0",
    "http-server": "14.1.1",
    "prettier": "3.9.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "typescript": "6.0.3",
    "typescript-eslint": "8.69.0",
    "vite": "8.2.2"
  }
}
