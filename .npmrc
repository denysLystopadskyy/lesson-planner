# Make `npm install <pkg>` write an exact version into package.json instead of
# a caret range, so the recorded "pin exactly" policy holds on any machine and
# not only where a global npm config happens to set it.
#
# Scope: this affects future installs only. The versions already in
# package.json and package-lock.json are literal and machine-independent on
# their own; `npm ci` does not read this setting.
#
# Never put a registry auth token in this file. It is tracked by git, and
# `npm config set --location project` writes here. See
# .claude/context/security-auth.md.
save-exact=true
