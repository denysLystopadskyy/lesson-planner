{
  "compilerOptions": {
    "target": "ES2022",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "lib": ["ES2022", "DOM"],
    "types": ["node", "@playwright/test"],
    "strict": true,
    // An index access can miss. Without this, `groups[0]` is typed as always
    // present, which makes a correct `?? fallback` look like dead code.
    "noUncheckedIndexedAccess": true,
    // `db/schema.ts` re-exports the tables from `api/[...all].ts` by that
    // file's real name, because Node 24 strips types at run time and there is
    // no `.js` to point at. TypeScript allows the spelling only when it is not
    // emitting, which is the case here. `api/tsconfig.json` has carried the
    // same flag, for the same reason, since batch 4.2.
    "allowImportingTsExtensions": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  // `db/**` is here for the same reason `neon.ts` is (plan batch 5.0): a file
  // that belongs to no TypeScript project fails typed linting on the file
  // rather than on its contents, because ESLint's `projectService` finds a
  // project by walking up from the file. Giving `db/` its own tsconfig would
  // work too, and would make a fourth project and a fourth typecheck script
  // for two files. This keeps the count at three.
  "include": [
    "db/**/*.ts",
    "drizzle.config.ts",
    "e2e/**/*.ts",
    "neon.ts",
    "playwright.config.ts",
    "vitest.config.ts"
  ]
}
