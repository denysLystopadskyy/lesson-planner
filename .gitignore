# Node and Playwright artifacts
node_modules
app/dist
playwright-report
test-results
e2e/.cache
.playwright-cache

# Generated research deliverables — Markdown is the source of record.
# Rebuild with: cd docs/research/tools && npm ci && node build-report.js <report.md>
docs/research/**/*.html
docs/research/**/*.pdf

# Secrets. Every real value lives in Vercel (created as Sensitive) or in an
# untracked local file — never here. `.env.example` is the exception and holds
# names only, so the list of variables is reviewable without the values being
# in the repository. See .claude/context/security-auth.md.
.env
.env.*
!.env.example

# Claude session artifacts — only the grouped context files are tracked
.claude/*
!.claude/context/
